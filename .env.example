# =============================================================
# English Chat App - Environment variables template
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` (it is git-ignored).
# =============================================================

# opencode Go API key. Get it at https://opencode.ai/auth
# The model itself is NOT an env var — it is pinned in src/lib/ai/provider.ts
# (TEACHER_MODEL_ID), next to the latency measurements that justify the choice.
OPENCODE_API_KEY="your-opencode-go-api-key"

# Neon PostgreSQL 18 connection string (pooled, sslmode=require).
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# -------------------------------------------------------------
# Password reset emails (SMTP). REQUIRED for the "forgot
# password" flow. Defaults below target Gmail — see README for
# the App Password setup. To use Outlook, Mailgun, etc., just
# override SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD.
# -------------------------------------------------------------
# SMTP_HOST="smtp.gmail.com"          # default
# SMTP_PORT="587"                     # 587 (STARTTLS) or 465 (SSL)
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="xxxx xxxx xxxx xxxx"  # 16-char Gmail App Password
# SMTP_FROM="English Conversation Tutor <you@gmail.com>"  # optional; defaults to SMTP_USER
# PUBLIC_BASE_URL="https://your-domain.com"   # used to build the reset link

# -------------------------------------------------------------
# Admin seeding (used only by `mise run db:seed` / `npm run db:seed`).
# ADMIN_PASSWORD is optional: if omitted, a strong one is generated
# and printed once. These are NOT read by the running app.
# -------------------------------------------------------------
# ADMIN_EMAIL="you@example.com"
# ADMIN_NAME="Your Name"
# ADMIN_PASSWORD=""
